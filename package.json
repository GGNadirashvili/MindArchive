{
  "name": "mindarchive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "data:philosophers": "node scripts/fetch-philosophers.mjs",
    "data:wikiquote": "node scripts/fetch-wikiquote.mjs && node scripts/parse-wikiquote.mjs",
    "data:gutenberg": "node scripts/fetch-gutenberg.mjs",
    "data:build": "node scripts/build-dataset.mjs",
    "data": "npm run data:philosophers && npm run data:wikiquote && npm run data:gutenberg && npm run data:build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
